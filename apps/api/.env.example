# ═══════════════════════════════════════════════════════════════════════════
# Nourish API — Environment Configuration
# Copy to .env (gitignored) and adjust for your environment.
# Dev defaults match docker-compose.yml (postgres:16-alpine).
#
# ── QUICK START ─────────────────────────────────────────────────────────────
# 1. Copy this file: cp .env.example .env
# 2. Generate a JWT_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 3. Get a free GEMINI_API_KEY at https://aistudio.google.com (1,500 req/day)
# 4. Get a free RESEND_API_KEY at https://resend.com (100 emails/day)
# 5. Set up Firebase project at https://console.firebase.google.com for free
#    phone auth. Use the project ID as FIREBASE_PROJECT_ID.
# 6. Create Google OAuth credentials at https://console.cloud.google.com/apis/credentials
#    for Android, iOS, and Web platforms.
#
# ── FREE HOSTING OPTIONS ────────────────────────────────────────────────────
# Option A: Render (free web service + free Postgres, 90-day Postgres limit)
#   - Use render.yaml in this repo (Blueprints → Use Existing)
#   - OR deploy manually: "New Web Service → Docker → rootDir: apps/api"
#   - Free dyno sleeps after 15 min idle (~30 sec cold start)
#
# Option B: Koyeb (always-on, 512 MB RAM, never sleeps — RECOMMENDED)
#   - Create App → Docker deployment from GitHub
#   - Add environment secrets matching this file
#   - Bind to a free Neon Postgres (see below)
#
# Option C: Railway ($5/mo credit covers hobby projects)
#   - New project → Deploy from GitHub repo
#   - Add Postgres service → copy DATABASE_URL
#
# ── FREE DATABASE OPTIONS ──────────────────────────────────────────────────
# • Neon Serverless Postgres (free forever, 500 MB, daily backups):
#   https://neon.tech  →  Create project → Copy connection string
#   Use the "pooled" connection string for Prisma.
#
# • Supabase Postgres (free tier, 500 MB):
#   https://supabase.com  →  New project → Settings → Database → Connection string
#
# • Render Postgres (free for 90 days, then $5/mo):
#   Included automatically if you use render.yaml above.
#
# ── MOBILE APP CONFIG ──────────────────────────────────────────────────────
# In apps/mobile-rn/.env (if file-based) or set via EAS secrets:
#   EXPO_PUBLIC_API_URL=https://your-api-host.com
#   EXPO_PUBLIC_REVENUECAT_IOS_API_KEY= (optional)
#   EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY= (optional)
#   EXPO_PUBLIC_REVENUECAT_MOCK=true  # for UAT/testing before store approval
#
# In apps/mobile-rn/.env (or via EAS):
#   NOURISH_API_URL=https://your-api-host.com
# ═══════════════════════════════════════════════════════════════════════════

# Postgres connection (Prisma). Test DB is provisioned separately by test/setup.ts.
DATABASE_URL=postgresql://nourish:nourish@localhost:5432/nourish?schema=public

# Redis — provisioned for S3 queue parity only; NOT used by the API in S1.
REDIS_URL=redis://localhost:6379

# HTTP port for the API server.
PORT=3000

# Comma-separated CORS origin allowlist. "http://localhost:*" matches any localhost
# port (dev only). Never use a bare "*" in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://localhost:*

# Rate limiting (global, per IP). /v1/healthz is exempt.
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_LIMIT=60

# Optional Sentry DSN. When unset, Sentry is fully disabled (ADR-0006 / D4).
SENTRY_DSN=

# ── S2: meal analysis (ADR-0007) ─────────────────────────────────────────────
# Which AI provider to use:
#   none              — no provider; POST /v1/analyses answers 503 honestly
#   gemini            — Google AI Studio free tier
#   openai-compatible — any OpenAI-compatible chat-completions endpoint
#   fixture           — deterministic test provider; REFUSED when NODE_ENV=production
AI_PROVIDER=none

# Required for AI_PROVIDER=gemini. Create a free key in Google AI Studio.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Required for AI_PROVIDER=openai-compatible. The key is read from the
# environment only and is never logged.
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
AI_VISION_MODEL=gpt-4o-mini
AI_TEXT_MODEL=gpt-4o-mini

# Provider call timeout, uploaded-image cap, and the process-wide daily ceiling
# on analyses (0 disables the budget guard).
AI_TIMEOUT_MS=20000
AI_MAX_IMAGE_BYTES=4194304
AI_DAILY_BUDGET=2000

# Per-route analysis rate limit (the global read limit above still applies to
# the catalog endpoints).
AI_RATE_LIMIT_LIMIT=10
AI_RATE_LIMIT_TTL_MS=60000

# Analysis-metadata retention for the purge CLI (npm run analysis:purge).
# Uploaded imagery is never stored, so this covers metadata rows only.
ANALYSIS_RETENTION_DAYS=30

# ── S3: accounts and sessions (ADR-0008) ─────────────────────────────────────
# HMAC key for access tokens. At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Required: the service refuses to start without it. Never commit a real value.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Per-IP ceilings for the sign-in routes (tighter than the read bucket: every
# code request costs an SMS).
OTP_REQUEST_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
OTP_RATE_LIMIT_TTL_MS=60000

# Which SMS gateway delivers sign-in codes:
#   none    — no gateway; sign-in requests answer 503 SMS_UNAVAILABLE
#   console — DEVELOPMENT ONLY, logs the code; refused when NODE_ENV=production
#   http    — generic operator gateway (POST url + optional bearer token)
SMS_PROVIDER=none
# SMS_API_URL=https://sms-gateway.example/send
# SMS_API_KEY=
SMS_SENDER=Nourish
SMS_TIMEOUT_MS=10000

# Free passwordless email OTP fallback:
#   none    — unavailable
#   console — DEVELOPMENT ONLY
#   resend  — Resend's free transactional-email tier
#   smtp    — any free SMTP mailbox/provider
EMAIL_OTP_PROVIDER=none
# RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
# OTP_EMAIL_FROM=Nourish <no-reply@your-verified-domain.example>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Public Google OAuth client IDs accepted as ID-token audiences.
# GOOGLE_CLIENT_IDS=web-client-id,ios-client-id,android-client-id
# GOOGLE_CLIENT_ID_IOS=
# GOOGLE_CLIENT_ID_ANDROID=
# GOOGLE_CLIENT_ID_WEB=

# Firebase phone authentication (free Spark plan). The backend verifies the
# client ID token; it does not call a paid SMS provider.
# FIREBASE_PROJECT_ID=

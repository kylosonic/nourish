// Nourish S1 — canonical food layer (blueprint §9).
// Food-layer models ONLY. No user/profile/meal tables in S1 (A11).
// Nutrition values: Ethiopian FCT 2025 (EPHI & FAO), per-100g edible portion.
// Portion gram weights are Nourish standard measures (portionSource: nourish-standard) — NOT FCT data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ImportStatus {
  Pending
  Committed
  Failed
}

enum FoodStatus {
  Active
  Deprecated
  Merged
}

enum AliasKind {
  alternate
  transliteration
  misspelling
  appTransliteration
}

model ImportRun {
  id              String        @id @default(cuid())
  sourceName      String // "ethiopian-fct-2025"
  sourceVersion   String // "2025"
  sourceReference String // full EPHI/FAO citation (ADR-0004)
  sourceUrl       String?
  fileName        String
  fileSha256      String
  extractSha256   String?
  /// Version of the local canonicalization rules (aliases, transliteration,
  /// categories, portions) that produced this run's derived fields. The source
  /// file hash alone cannot express "same data, different rules", so a rule
  /// change must create a new run instead of an idempotent no-op. Nullable for
  /// runs imported before this column existed.
  rulesVersion    String?
  rowCount        Int
  status          ImportStatus @default(Pending)
  notes           String?
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  foods           Food[]

  @@unique([sourceName, sourceVersion, fileSha256, rulesVersion]) // idempotency gate
}

model Food {
  id                 String         @id // stable: seed slug when name-matches a bootstrap food, else "fct-<sourceFoodCode>"
  canonicalName      String
  categoryCode       String
  category           FoodCategory   @relation(fields: [categoryCode], references: [code])
  description        String?
  region             String?
  preparation        String? // master §11
  status             FoodStatus     @default(Active)
  verification       String?
  confidence         Float? // master §11 (S2+ semantics; schema-ready)
  defaultPortionUnit String
  defaultPortionQty  Float          @default(1)
  defaultPortionGrams Float
  per100gKcal        Float
  per100gProtein     Float
  per100gCarbs       Float
  per100gFat         Float
  per100gFiber       Float?
  per100gSodiumMg    Float?
  extraNutrients     Json? // documented keys (energyKj, ashG, calciumMg, ironMg, vitaminA_ug, ...); row-level provenance still applies
  importId           String
  import             ImportRun      @relation(fields: [importId], references: [id])
  sourceFoodCode     String         @unique // upsert key across re-imports
  aliases            FoodAlias[]
  portions           FoodPortion[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([canonicalName])
  @@index([categoryCode])
}

model FoodAlias {
  id         String    @id @default(cuid())
  foodId     String
  food       Food      @relation(fields: [foodId], references: [id], onDelete: Cascade)
  alias      String
  language   String // "en"|"am"|"om"
  kind       AliasKind @default(alternate)
  normalized String // lower + collapse whitespace; searched via ILIKE

  @@unique([foodId, alias, language])
  @@index([normalized])
}

model FoodPortion {
  id            String  @id @default(cuid())
  foodId        String
  food          Food    @relation(fields: [foodId], references: [id], onDelete: Cascade)
  unit          String // PortionUnit.name
  quantity      Float   @default(1)
  grams         Float
  portionSource String  @default("nourish-standard") // honesty: gram weights are NOT FCT data

  @@unique([foodId, unit])
}

model FoodCategory {
  code  String @id
  label String
  foods Food[]
}

// ── S2: AI analysis layer (ADR-0007) ─────────────────────────────────────────
// Anonymous by construction: no user identity is stored. `userId` is a nullable
// reservation for the S3 account link and is always null in S2. No imagery is
// persisted anywhere — uploaded bytes live in memory for one request only, so
// SAFE-05's retention rule is satisfied structurally rather than by a policy.

enum AnalysisStatus {
  Completed
  Failed
}

enum AnalysisInputKind {
  Photo
  Text
}

enum ConfidenceState {
  High
  Medium
  Low
}

/** How a model-supplied label was resolved against the canonical food layer. */
enum MatchKind {
  exact
  alias
  fuzzy
  none
}

model AnalysisRun {
  id                String            @id @default(cuid())
  status            AnalysisStatus
  inputKind         AnalysisInputKind
  overallConfidence Float
  confidenceState   ConfidenceState
  modelVersion      String
  promptVersion     String
  /// Human-readable reasons: unresolved candidates, no food detected, etc.
  notes             Json?
  /// Machine-readable failure code when status = Failed (never a provider body).
  failureCode       String?
  /// Reserved for S3; null throughout S2.
  userId            String?
  createdAt         DateTime          @default(now())

  items       AnalysisItem[]
  candidates  AnalysisCandidate[]
  corrections AnalysisCorrection[]

  @@index([createdAt])
  @@index([userId])
}

model AnalysisItem {
  id               String        @id @default(cuid())
  runId            String
  run              AnalysisRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Model-supplied label, kept verbatim for correction analysis.
  displayName      String
  /// Canonical application id (the same namespace /v1/foods/:id uses); null when
  /// the candidate could not be resolved — never invented (ADR-0004/ADR-0007).
  foodId           String?
  sourceFoodCode   String?
  canonicalName    String?
  matchKind        MatchKind
  portionAmount    Float
  portionUnit      String
  portionGrams     Float
  /// True when the gram weight came from the provider rather than the food
  /// layer's portion table, i.e. it is an estimate and must be shown as one.
  portionEstimated Boolean       @default(false)
  portionSource    String        @default("nourish-standard")
  /// Deterministic per-100g × grams / 100 results; null when unresolved.
  kcal             Float?
  proteinG         Float?
  carbsG           Float?
  fatG             Float?
  fiberG           Float?
  sodiumMg         Float?
  confidence       Float
  unresolved       Boolean       @default(false)

  @@index([runId])
}

/** Ranked alternatives shown by the low-confidence screen (SCAN-06). */
model AnalysisCandidate {
  id          String      @id @default(cuid())
  runId       String
  run         AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  displayName String
  foodId      String?
  confidence  Float
  rank        Int

  @@index([runId])
}

/**
 * SAFE-07 correction capture without identity: the prediction, what the user
 * chose instead, and the model/prompt versions. No user id, no imagery, no free
 * text — quality analytics, never model training (SAFE-06 stays default-off).
 */
model AnalysisCorrection {
  id             String      @id @default(cuid())
  runId          String
  run            AnalysisRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId         String?
  action         String // swap | portion | remove | add
  predictedLabel String?
  chosenFoodId   String?
  chosenAmount   Float?
  chosenUnit     String?
  modelVersion   String
  promptVersion  String
  createdAt      DateTime    @default(now())

  @@index([runId])
}

# Base URL without the /v1 suffix.
# Android emulator: http://10.0.2.2:3000
# iOS simulator: http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public OAuth client IDs created in Google Cloud Console. The same IDs must
# appear in the API's GOOGLE_CLIENT_IDS list.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Canonical release metadata. Keep pointed at the production R2/CDN document.
EXPO_PUBLIC_RELEASE_URL=https://downloads.nourish.app/metadata/latest.json
